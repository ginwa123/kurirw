.{
    .name = .kurirw,
    .version = "0.1.13",
    .fingerprint = 0xb79b56d6a2fb776b,
    .minimum_zig_version = "0.16.0",
    // The two real dependencies, pinned by commit: a clone builds them from source.
    //   glinlandui  the toolkit (Cocoa on macOS, Wayland on Linux, Win32 on Windows)
    //   kabelweb    the libcurl-backed HTTP client Kurir sends with
    //   zginlint    the linter behind `zig build zginlint:check`
    // To work on a dependency locally, point its entry at a path (`.path = "../glinlandui"`).
    .dependencies = .{
        .glinlandui = .{
            .url = "git+https://github.com/ginwa123/glinlandui.git#010352ad37e13d6a8d926d342370e4d8f0003843",
            .hash = "glinlandui-0.0.0-ngP3RmgrNAAKz54cPERCb8UKbTU7bAHoyiJUMacdCaiv",
        },
        .kabelweb = .{
            .url = "git+https://github.com/ginwa123/kabelweb.git#1726a5786b49f0c9469d99219232eb52f4766339",
            .hash = "kabelweb-0.0.0-vhZamxGFkAAySnN2nnm_TkYfeUVob6NW2eiSoGZxjYod",
        },
        .zginlint = .{
            .url = "git+https://github.com/ginwa123/zglint.git#d25af4bfd49ec371cca029ffa8484778751f1f55",
            .hash = "zginlint-0.0.0-0kYHpmJ2AQDGniUShnLb-t7DaetEklCbpu2AXOXgpARe",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "README.md",
        "AGENTS.md",
    },
}
